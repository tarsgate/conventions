diff --git a/Dockerfile.base b/Dockerfile.base
index 099e36d..46fd400 100644
--- a/Dockerfile.base
+++ b/Dockerfile.base
@@ -16,6 +16,130 @@ RUN apt --yes install --no-install-recommends dotnet-sdk-10.0
 RUN apt --yes install --no-install-recommends npm
 RUN npm install --global yarn
 
+RUN apt --yes install --no-install-recommends openssh-server
+RUN apt --yes install --no-install-recommends cron
+RUN apt --yes install --no-install-recommends sudo
+RUN apt --yes install --no-install-recommends wget
+RUN apt --yes install --no-install-recommends postgresql
+RUN apt --yes install --no-install-recommends nginx
+RUN apt --yes install --no-install-recommends socat
+RUN apt --yes install --no-install-recommends supervisor
+RUN apt --yes install --no-install-recommends unzip
+# for `killall` command
+RUN apt --yes install --no-install-recommends psmisc
+# for `make` command
+RUN apt --yes install --no-install-recommends build-essential
+# For network diagnostics. In case there are problems with network connectivity we want to diagnose.
+RUN apt --yes install --no-install-recommends iputils-ping
+RUN apt --yes install --no-install-recommends net-tools
+
+# Playwright dependencies
+RUN apt --yes install --no-install-recommends xvfb
+RUN apt --yes install --no-install-recommends fonts-noto-color-emoji
+RUN apt --yes install --no-install-recommends fonts-unifont
+RUN apt --yes install --no-install-recommends libfontconfig1
+RUN apt --yes install --no-install-recommends libfreetype6
+RUN apt --yes install --no-install-recommends xfonts-cyrillic
+RUN apt --yes install --no-install-recommends xfonts-scalable
+RUN apt --yes install --no-install-recommends fonts-liberation
+RUN apt --yes install --no-install-recommends fonts-ipafont-gothic
+RUN apt --yes install --no-install-recommends fonts-wqy-zenhei
+RUN apt --yes install --no-install-recommends fonts-tlwg-loma-otf
+RUN apt --yes install --no-install-recommends fonts-freefont-ttf
+RUN apt --yes install --no-install-recommends libasound2t64
+RUN apt --yes install --no-install-recommends libatk-bridge2.0-0t64
+RUN apt --yes install --no-install-recommends libatk1.0-0t64
+RUN apt --yes install --no-install-recommends libatspi2.0-0t64
+RUN apt --yes install --no-install-recommends libcairo2
+RUN apt --yes install --no-install-recommends libcups2t64
+RUN apt --yes install --no-install-recommends libdbus-1-3
+RUN apt --yes install --no-install-recommends libdrm2
+RUN apt --yes install --no-install-recommends libgbm1
+RUN apt --yes install --no-install-recommends libglib2.0-0t64
+RUN apt --yes install --no-install-recommends libnspr4
+RUN apt --yes install --no-install-recommends libnss3
+RUN apt --yes install --no-install-recommends libpango-1.0-0
+RUN apt --yes install --no-install-recommends libx11-6
+RUN apt --yes install --no-install-recommends libxcb1
+RUN apt --yes install --no-install-recommends libxcomposite1
+RUN apt --yes install --no-install-recommends libxdamage1
+RUN apt --yes install --no-install-recommends libxext6
+RUN apt --yes install --no-install-recommends libxfixes3
+RUN apt --yes install --no-install-recommends libxkbcommon0
+RUN apt --yes install --no-install-recommends libxrandr2
+RUN apt --yes install --no-install-recommends libavcodec62
+RUN apt --yes install --no-install-recommends libcairo-gobject2
+RUN apt --yes install --no-install-recommends libgdk-pixbuf-2.0-0
+RUN apt --yes install --no-install-recommends libgtk-3-0t64
+RUN apt --yes install --no-install-recommends libpangocairo-1.0-0
+RUN apt --yes install --no-install-recommends libx11-xcb1
+RUN apt --yes install --no-install-recommends libxcb-shm0
+RUN apt --yes install --no-install-recommends libxcursor1
+RUN apt --yes install --no-install-recommends libxi6
+RUN apt --yes install --no-install-recommends libxrender1
+RUN apt --yes install --no-install-recommends gstreamer1.0-libav
+RUN apt --yes install --no-install-recommends gstreamer1.0-plugins-bad
+RUN apt --yes install --no-install-recommends gstreamer1.0-plugins-base
+RUN apt --yes install --no-install-recommends gstreamer1.0-plugins-good
+RUN apt --yes install --no-install-recommends libicu78
+RUN apt --yes install --no-install-recommends libatomic1
+RUN apt --yes install --no-install-recommends libenchant-2-2
+RUN apt --yes install --no-install-recommends libepoxy0
+RUN apt --yes install --no-install-recommends libevent-2.1-7t64
+RUN apt --yes install --no-install-recommends libflite1
+RUN apt --yes install --no-install-recommends libgles2
+RUN apt --yes install --no-install-recommends libgstreamer-gl1.0-0
+RUN apt --yes install --no-install-recommends libgstreamer-plugins-bad1.0-0
+RUN apt --yes install --no-install-recommends libgstreamer-plugins-base1.0-0
+RUN apt --yes install --no-install-recommends libgstreamer1.0-0
+RUN apt --yes install --no-install-recommends libgtk-4-1
+RUN apt --yes install --no-install-recommends libharfbuzz-icu0
+RUN apt --yes install --no-install-recommends libharfbuzz0b
+RUN apt --yes install --no-install-recommends libhyphen0
+RUN apt --yes install --no-install-recommends libjpeg-turbo8
+RUN apt --yes install --no-install-recommends liblcms2-2
+RUN apt --yes install --no-install-recommends libmanette-0.2-0
+RUN apt --yes install --no-install-recommends libopus0
+RUN apt --yes install --no-install-recommends libpng16-16t64
+RUN apt --yes install --no-install-recommends libsecret-1-0
+RUN apt --yes install --no-install-recommends libvpx12
+RUN apt --yes install --no-install-recommends libwayland-client0
+RUN apt --yes install --no-install-recommends libwayland-egl1
+RUN apt --yes install --no-install-recommends libwayland-server0
+RUN apt --yes install --no-install-recommends libwebp7
+RUN apt --yes install --no-install-recommends libwebpdemux2
+RUN apt --yes install --no-install-recommends libwoff1
+RUN apt --yes install --no-install-recommends libxml2-16
+RUN apt --yes install --no-install-recommends libxslt1.1
+RUN apt --yes install --no-install-recommends libx264-165
+RUN apt --yes install --no-install-recommends libavif16
+
+# Pulumi CLI
+ARG PULUMI_VERSION=3.201.0
+RUN wget https://get.pulumi.com/releases/sdk/pulumi-v$PULUMI_VERSION-linux-x64.tar.gz --output-document=pulumi.tar.gz
+RUN tar --extract --gzip --verbose --file pulumi.tar.gz
+RUN rm pulumi.tar.gz
+RUN mv ./pulumi /usr/local/bin/pulumi
+RUN chmod +x /usr/local/bin/pulumi
+
+# Install Pulumi providers
+ADD scripts/installPulumiProvider.fsx /usr/local/bin/installPulumiProvider.fsx
+RUN installPulumiProvider.fsx bitlaunch 0.4.2
+RUN installPulumiProvider.fsx lnvps 0.0.47
+RUN installPulumiProvider.fsx namesilo 0.0.7
+RUN installPulumiProvider.fsx unhumandomains 0.0.8
+
+# Install Xray (use script in latest commit in XTLS/Xray-install repo as of writing this script)
+RUN wget https://raw.githubusercontent.com/XTLS/Xray-install/b7410c4e2fe2ed5c0ddca508eba2f4e42a91e1d2/install-release.sh
+RUN wget https://github.com/XTLS/Xray-core/releases/download/v25.9.11/Xray-linux-64.zip
+RUN chmod +x ./install-release.sh
+# by creating dockerenv file, we prevent install-release.sh to try to detect systemd, which would end up failing, because systemd can't run inside docker/podman
+RUN touch /.dockerenv
+# install-release.sh will prompt to press any key with local install, so use "yes" command to simulate key press
+RUN yes | ./install-release.sh --local ./Xray-linux-64.zip
+RUN rm ./install-release.sh
+RUN rm ./Xray-linux-64.zip
+
 # cleanup apt cache to reduce img size & avoid unneeded files in the final layer
 RUN rm -rf /var/lib/apt/lists/*
 
